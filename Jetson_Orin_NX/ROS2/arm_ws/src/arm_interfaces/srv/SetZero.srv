# 设零: 把电机当前位置标定为 calib_deg 显示角
#
# 实现要求（零点重写踩坑全集内置）:
#  V3: 记 E0 档案——校验角度源=0x92 已到位后再记（防记错圈 ±360N）
#  V4: 三步时序 0x80→500ms→0x64→1000ms→0x76→等 10s 复位;
#      设零期间暂停轮询（独占总线节奏，防 0x76 被背靠背帧损坏）
#
# 校验: 设零前 0x92 应出现 >=10s 无回复空窗再归 0——无空窗 = 0x76 未执行（失败）

int8 motor_id
float32 calib_deg   # 当前位置应显示的角（通常 0 或凸点已知角，支持负）
---
bool ok
string msg          # 成功/失败原因（人读）
float32 new_e0      # V3: 新 E0 档案值（NaN=未变/非 V3）
float32 new_e4      # V4: 新 E4 偏移（NaN=未变/非 V4）
